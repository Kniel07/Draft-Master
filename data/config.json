  "weights": {
    "note": "One place. Nothing in the UI or the engine hardcodes a weight. Values are relative — they are normalised by their own sum, so they do not have to add to 1.",
    "pick": {
      "meta": 0.2,
      "counter": 0.25,
      "synergy": 0.2,
      "roleFit": 0.15,
      "comfort": 0.1,
      "flexibility": 0.1
    },
    "ban": {
      "meta": 0.2,
      "enemyThreat": 0.25,
      "counterRisk": 0.23,
      "rankPopularity": 0.13,
      "comfortRisk": 0.1,
      "flexibility": 0.09
    },
    "composition": {
      "note": "Extra nudge applied to a pick score for covering the draft's thinnest dimensions. Kept separate from the six headline weights so those stay readable.",
      "need": 0.12
    }
  },
  "modes": {
    "ranked": {
      "id": "ranked",
      "label": "Ranked",
      "description": "Epic through Mythical Immortal. The app follows the real Ranked structure; you record the lobby as it happens.",
      "sequenced": false,
      "guided": true,
      "teamSize": 5,
      "note": "Ranked is guided, not sequenced. There is a real structure — rank decides the ban count, bans are blind and simultaneous, picks run a snake — so the app always knows what phase it is in and what comes next. But every slot stays directly addressable, because the app is not in the lobby: a ban can be revealed late, a pick can be missed, and the player must always be able to record what actually happened rather than what the sequence expected.",
      "banStyle": "blind-simultaneous",
      "banStyleNote": "In Ranked both teams ban at the same time without seeing each other's choices; the enemy's bans are revealed afterwards. So the app asks for your bans first — that is your decision window, and the only point where a ban recommendation can matter — and then for theirs once you can see them.",
      "rulesets": {
        "epic": {
          "bansPerTeam": 3
        },
        "legend": {
          "bansPerTeam": 4
        },
        "mythic": {
          "bansPerTeam": 5
        },
        "honor": {
          "bansPerTeam": 5
        },
        "glory": {
          "bansPerTeam": 5
        },
        "immortal": {
          "bansPerTeam": 5
        }
      },
      "rulesetSource": "Draft Pick allows up to 10 bans (3/4/5 at Epic/Legend/Mythic per team); picks run Blue 1, Red 1-2, Blue 2-3, Red 3-4, Blue 4-5, Red 5. Verified against the MLBB Draft Pick wiki and LaroHub's ranked draft guide, 2026-08.",
      "pickOrder": [
        "ally",
        "enemy",
        "enemy",
        "ally",
        "ally",
        "enemy",
        "enemy",
        "ally",
        "ally",
        "enemy"
      ],
      "pickOrderNote": "Written from the perspective of our team picking first. Mirrored when the enemy has first pick."
    },
    "tournament": {
      "id": "tournament",
      "label": "Tournament",
      "description": "MPL / M-Series standard. 10 bans, 10 picks, fixed order.",
      "sequenced": true,
      "teamSize": 5,
      "format": "mpl-standard"
    }
  },
